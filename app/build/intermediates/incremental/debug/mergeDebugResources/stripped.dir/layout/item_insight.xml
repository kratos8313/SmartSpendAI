<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_insight"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp">

    <!-- Severity bar on the left -->
    <View
        android:id="@+id/view_severity_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingStart="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_insight_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_trend"
                android:contentDescription="Insight icon" />

            <TextView
                android:id="@+id/tv_insight_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Insight Title"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginStart="10dp"
                android:maxLines="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_insight_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Insight message goes here."
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.4" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
